From 4adecf773de4580140b120843859bac06fb78bbd Mon Sep 17 00:00:00 2001
From: cctv18 <85936817+cctv18@users.noreply.github.com>
Date: Sun, 26 Jul 2026 05:23:02 +0800
Subject: [PATCH] drm/atomic: validate clones only for explicit encoder masks

Fix the screen flickering issue caused by 6.1.118 OKI kernel source code.
Cherrypicked from commit (https://github.com/xkse4/android_kernel_common_oneplus_sm8750/commit/db5763098215b371037a161b34b55e854675a8b2).

Co-Authored-By: xkse4UwU <xkse4@outlook.com>
---
 drivers/gpu/drm/drm_atomic_helper.c |  5 ++---
 drivers/gpu/drm/drm_mode_config.c   |  7 ++++++-
 include/drm/drm_mode_config.h       | 11 +++++++++++
 3 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 1aa59586c8f81..e81c58193472e 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -581,10 +581,9 @@ static int drm_atomic_check_valid_clones(struct drm_atomic_state *state,
 									  crtc);
 
 	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask) {
-		if (!drm_enc->possible_clones) {
-			DRM_DEBUG("enc%d possible_clones is 0\n", drm_enc->base.id);
+		if (!(crtc->dev->mode_config.encoder_clones_explicit &
+		      drm_encoder_mask(drm_enc)))
 			continue;
-		}
 
 		if ((crtc_state->encoder_mask & drm_enc->possible_clones) !=
 		    crtc_state->encoder_mask) {
diff --git a/drivers/gpu/drm/drm_mode_config.c b/drivers/gpu/drm/drm_mode_config.c
index 87eb591fe9b5b..cc1db643220a8 100644
--- a/drivers/gpu/drm/drm_mode_config.c
+++ b/drivers/gpu/drm/drm_mode_config.c
@@ -435,6 +435,7 @@ int drmm_mode_config_init(struct drm_device *dev)
 	dev->mode_config.num_connector = 0;
 	dev->mode_config.num_crtc = 0;
 	dev->mode_config.num_encoder = 0;
+	dev->mode_config.encoder_clones_explicit = 0;
 	dev->mode_config.num_total_plane = 0;
 
 	if (IS_ENABLED(CONFIG_LOCKDEP)) {
@@ -578,8 +579,12 @@ static u32 full_encoder_mask(struct drm_device *dev)
  */
 static void fixup_encoder_possible_clones(struct drm_encoder *encoder)
 {
-	if (encoder->possible_clones == 0)
+	if (encoder->possible_clones == 0) {
 		encoder->possible_clones = drm_encoder_mask(encoder);
+	} else {
+		encoder->dev->mode_config.encoder_clones_explicit |=
+			drm_encoder_mask(encoder);
+	}
 }
 
 static void validate_encoder_possible_clones(struct drm_encoder *encoder)
diff --git a/include/drm/drm_mode_config.h b/include/drm/drm_mode_config.h
index 973119a9176b2..f8c733c88a10f 100644
--- a/include/drm/drm_mode_config.h
+++ b/include/drm/drm_mode_config.h
@@ -480,6 +480,17 @@ struct drm_mode_config {
 	 * lifetime of a device and hence doesn't need any locks.
 	 */
 	int num_encoder;
+#ifndef __GENKSYMS__ /* Placed in an existing hole in the structure. */
+	/**
+	 * @encoder_clones_explicit:
+	 *
+	 * Bitmask of encoders for which the driver explicitly initialized
+	 * &drm_encoder.possible_clones before mode-config validation. Encoders
+	 * without a bit set predate generic clone validation and remain subject
+	 * to the driver's atomic checks.
+	 */
+	u32 encoder_clones_explicit;
+#endif
 	/**
 	 * @encoder_list:
 	 *
